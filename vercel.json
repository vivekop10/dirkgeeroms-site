{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/assets/gallery/:match*",
      "destination": "https://test.dirkgeeroms.be/wp-content/gallery/:match*"
    },
    {
      "source": "/gallery/:match*",
      "destination": "https://test.dirkgeeroms.be/wp-content/gallery/:match*"
    },
    {
      "source": "/wp-content/gallery/:match*",
      "destination": "https://test.dirkgeeroms.be/wp-content/gallery/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
